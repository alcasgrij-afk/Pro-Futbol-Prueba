# =============================================================================
# Pro Futbol Antigua - Variables de entorno (ejemplo)
# Copiar a apps/api/.env y llenar con valores reales.
# NUNCA commitear el archivo .env real al repositorio.
# =============================================================================

# --- Aplicacion ---
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Zona horaria del negocio (usada por los jobs programados: recordatorios,
# liberacion de reservas, cobros de academia)
TZ=America/Guatemala

# --- Base de datos (Postgres) ---
DATABASE_URL="postgresql://profutbol:profutbol_dev_password@localhost:5432/profutbol_antigua?schema=public"

# --- Redis (sesiones del chatbot web, locks, colas BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Autenticacion (panel admin) ---
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=CAMBIAR_ESTE_VALOR_EN_PRODUCCION
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CAMBIAR_ESTE_OTRO_VALOR_EN_PRODUCCION
JWT_REFRESH_EXPIRES_IN=7d

# --- Pasarela de pago: BAC Credomatic / NeoNet (redireccion) ---
# Si BAC_API_URL + BAC_API_KEY estan configurados, el pago redirige a la
# pasarela real. Si estan vacios, se usa un gateway simulado de desarrollo
# (la pagina /pago/resultado confirma el pago localmente).
BAC_API_URL=
BAC_API_KEY=
BAC_WEBHOOK_SECRET=
NEONET_API_URL=
NEONET_API_KEY=
NEONET_WEBHOOK_SECRET=
# URL de retorno tras pagar (si esta vacia se deriva de WEB_URL)
PAYMENT_RETURN_URL=

# --- Reserva: reglas de negocio ---
RESERVA_TIMEOUT_PAGO_EN_LINEA_MIN=15
RESERVA_TIMEOUT_PAGO_EN_SEDE_MIN=30

# --- Academia (Fase 4): reglas de negocio ---
ACADEMIA_MENSUALIDAD_Q=150
ACADEMIA_DIAS_GRACIA_PAGO=5

# --- Observabilidad ---
SENTRY_DSN=
LOG_LEVEL=debug
